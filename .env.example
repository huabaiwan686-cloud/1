# 复制为 .env 后修改
JWT_SECRET_KEY=请改成32位以上随机字符串（生产必填，否则容器拒绝启动）

# ---- Bot Token 落库加密（Fernet，生产必须配置）----
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_FERNET_KEY=

# ---- TG 协议号真实登录/采集/推送（https://my.telegram.org/apps 申请）----
# 不配置则登录走模拟流程，不影响其他功能
TG_API_ID=
TG_API_HASH=
# TG 会话文件目录（默认 backend/data/tg_sessions）
TG_SESSION_DIR=

# ---- USDT-TRC20 自动收款 ----
# 收款地址（只需地址，不要私钥）；配置后 POST /api/vip/pay/watch 可自动到账开通
# 可挂 cron 每 2 分钟跑一次；不配置则走后台人工 mark_paid
USDT_TRC20_ADDRESS=
# Trongrid API Key（可选，不填用免费额度）
TRONGRID_API_KEY=
